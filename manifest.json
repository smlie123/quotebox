{
  "manifest_version": 3,
  "name": "QuoteBox – Save Text & Images from Web Pages Instantly",
  "version": "1.4.0",
  "description": "QuoteBox helps you save meaningful text and images from web pages instantly — without interrupting your reading.",
  "permissions": [
    "contextMenus",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],


  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuoteBox",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
